{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "research",
  "agent": {
    "planner": {
      "description": "Bộ não Team Dev — điều phối Developer/Tester/Reviewer từng bước một, không tự thiết kế",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./.opencode/agent/planner.md}",
      "permission": {
        "task": {
          "*": "deny",
          "developer": "allow",
          "tester": "allow",
          "reviewer": "allow"
        },
        "codegraph*": "allow",
        "postgres*": "deny",
        "edit": {
          ".scratch/**": "allow",
          ".brain/evidence/**": "allow",
          "**": "deny"
        },
        "bash": "ask"
      }
    },
    "research": {
      "description": "Agent default, thảo luận thiết kế trực tiếp với người dùng bằng bộ skill mattpocock cho đến khi ra ticket",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./.opencode/agent/research.md}",
      "permission": {
        "task": "deny",
        "codegraph*": "allow",
        "postgres*": "deny",
        "edit": {
          "docs/**": "allow",
          "research/**": "allow",
          ".scratch/**": "allow",
          "**": "deny"
        },
        "bash": "ask"
      }
    },
    "developer": {
      "description": "Thực thi ticket bằng /implement theo đúng lệnh cụ thể do Planner giao, không tự quyết bước tiếp theo",
      "mode": "all",
      "model": "muse-spark-1.3-contributor-free",
      "prompt": "{file:./.opencode/agent/developer.md}",
      "permission": {
        "task": "deny",
        "codegraph*": "allow",
        "postgres*": "allow",
        "edit": {
          "docs/**": "deny",
          "research/**": "deny",
          ".scratch/**": "deny",
          "**": "allow"
        },
        "bash": {
          "*": "allow",
          "git push --force*": "deny",
          "git push -f*": "deny",
          "rm -rf *": "deny",
          "git reset --hard*": "ask",
          "git commit *": "deny",
          "npm install *": "ask",
          "pip install *": "ask"
        }
      }
    },
    "tester": {
      "description": "Chạy đúng phạm vi test (typecheck/Playwright/hạ tầng) do Planner chỉ định, báo kết quả thô",
      "mode": "all",
      "model": "gemini-3.6-flash",
      "prompt": "{file:./.opencode/agent/tester.md}",
      "permission": {
        "task": "deny",
        "codegraph*": "allow",
        "postgres*": "allow",
        "edit": {
          "tests/**": "allow",
          "e2e/**": "allow",
          ".brain/evidence/**": "allow",
          "**": "deny"
        },
        "bash": "allow"
      }
    },
    "reviewer": {
      "description": "Chấm checklist review do Planner giao, báo PASS/FAIL kèm bằng chứng, duy nhất được commit khi Planner ra lệnh",
      "mode": "all",
      "model": "openai/gpt-5.6-luna",
      "prompt": "{file:./.opencode/agent/reviewer.md}",
      "permission": {
        "task": "deny",
        "codegraph*": "allow",
        "postgres*": "deny",
        "edit": {
          ".brain/evidence/**": "allow",
          ".scratch/**": "ask",
          "**": "ask"
        },
        "bash": {
          "*": "ask",
          "git add *": "allow",
          "git commit *": "allow",
          "git push*": "ask"
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "rm -rf *": "deny",
      "git reset --hard*": "ask",
      "npm install *": "ask",
      "pip install *": "ask"
    },
    "edit": {
      "**": "ask",
      ".env": "deny",
      ".env.*": "deny",
      "**/secrets/**": "deny",
      "**/.github/workflows/**": "ask"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://user:pass@localhost:5432/dbname"
      ],
      "enabled": true
    }
  }
}